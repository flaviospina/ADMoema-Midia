# =====================================================================
# Central de Mídia ADMoema — Envio de Fotos
# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# NUNCA envie o arquivo .env para o GitHub.
# =====================================================================

# local = desenvolvimento (permite HTTP) | production = servidor (exige HTTPS)
APP_ENV=production

# Endereço público do sistema, sem barra no final
APP_URL=https://admoema.com.br/midia

# Chave secreta (64 caracteres hexadecimais). Usada para criptografar o
# segredo do 2FA. Se estiver vazia, a página de instalação gera uma para você.
# NÃO troque depois de ativar o 2FA dos usuários.
APP_KEY=

# Token de instalação: escolha uma frase longa e única. Ele é pedido na
# página /instalar.php para criar o primeiro administrador.
INSTALL_TOKEN=

# Banco de dados (crie pelo cPanel > Bancos de dados MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Pasta onde as fotos ficam gravadas. Deixe vazio para usar ./storage
# Recomendado: uma pasta FORA do public_html, ex.: /home/SEU_USUARIO/midia_storage
STORAGE_PATH=

# Segurança da sessão
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# 2FA (Google Authenticator / Microsoft Authenticator / Authy)
# 1 = administradores são obrigados a ativar o 2FA no primeiro acesso
REQUIRE_2FA_ADMIN=1

# Proteção contra força bruta
LOGIN_MAX_FAILS_PER_IP=10
LOGIN_MAX_FAILS_PER_ACCOUNT=5
LOGIN_WINDOW_MINUTES=15

# Verifica se a senha nova já vazou na internet (Have I Been Pwned).
# Envia apenas os 5 primeiros caracteres do hash SHA-1 da senha, nunca a senha.
# 1 = ativado | 0 = desativado
PASSWORD_PWNED_CHECK=0

# Envio de fotos
UPLOAD_MAX_MB=40
# Tamanho de cada pedaço do envio. 2 MB funciona em qualquer HostGator.
UPLOAD_CHUNK_MB=2

# Redes sociais (Meta: Facebook e Instagram)
# Cada pessoa conecta a PRÓPRIA conta em "Minha conta" — nada de credencial aqui.
# Versão da Graph API da Meta. Atualize quando a Meta avisar que a versão vai expirar.
META_GRAPH_VERSION=v26.0
